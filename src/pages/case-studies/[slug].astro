---
//@ts-nocheck
import { getCaseStudies } from "@lib/api";
import { Image } from "astro:assets";
import Layout from "@layouts/Layout.astro";

export async function getStaticPaths() {
  const caseStudies = await getCaseStudies();

  return caseStudies.map((caseStudy) => ({
    params: { slug: caseStudy.slug },
    props: { caseStudy },
  }));
}

const { caseStudy } = Astro.props;
const { caseName, category, date, image, buttonLabel } = caseStudy.caseDetails;
---

<Layout>
  <section class="case-hero" aria-labelledby="case-title">
    <div class="case-hero-content">
      <p class="case-eyebrow">CASE STUDIES</p>

      <div class="case-title-wrapper">
        <h1 id="case-title">{caseStudy.title}</h1>
        <span class="case-title-line" aria-hidden="true"></span>
      </div>

      <p class="case-intro">
        Our achievements reflect the close collaboration between our expert
        teams and our esteemed clientele. We cultivate a workplace that
        champions peak performance and guarantees client satisfaction.
      </p>
    </div>
  </section>

  <article class="case-story-article" aria-labelledby="case-title">
    <header class="case-story-header">
      <Image
        src={image.src}
        alt={image.alt}
        width={image.width}
        height={image.height}
      />

      <div class="case-details">
        <dl>
          <div>
            <dt>Case Name</dt>
            <dd>{caseName}</dd>
          </div>

          <div>
            <dt>Category</dt>
            <dd class="category">{category}</dd>
          </div>

          <div>
            <dt>Date</dt>
            <dd class="date">{date}</dd>
          </div>
        </dl>

        <a href="#project-result" class="button">{buttonLabel}</a>
      </div>
    </header>

    <div class="case-story-content">
      {
        caseStudy.sections.map((section, index) => (
          <section
            class="case-section"
            id={
              index === caseStudy.sections.length - 1
                ? "project-result"
                : undefined
            }
            aria-labelledby={`case-section-${index}`}
          >
            <h2 id={`case-section-${index}`}>{section.title}</h2>

            {Array.isArray(section.content) ? (
              section.content.map((item) => <p>{item}</p>)
            ) : (
              <p>{section.content}</p>
            )}

            {section.highlights && (
              <ul>
                {section.highlights.map((highlight) => (
                  <li>{highlight}</li>
                ))}
              </ul>
            )}

            {section.image && (
              <figure>
                <Image
                  src={section.image.src}
                  alt={section.image.alt}
                  width={section.image.width}
                  height={section.image.height}
                />

                {section.image.caption && (
                  <figcaption>{section.image.caption}</figcaption>
                )}
              </figure>
            )}
          </section>
        ))
      }
    </div>
  </article>
</Layout>

<style>
  .case-hero {
    background-color: var(--color-surface-secondary);
    padding-block: clamp(5rem, 9vw, 7rem) clamp(4rem, 7vw, 5rem);
    text-align: center;
  }

  .case-hero-content {
    max-inline-size: 850px;
    margin-inline: auto;
    padding-inline: 1.5rem;
  }

  .case-eyebrow {
    margin: 0 0 1.25rem;
    color: var(--color-text-muted);
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.12em;
  }

  .case-title-wrapper {
    position: relative;
    display: inline-block;
  }

  .case-title-wrapper h1 {
    position: relative;
    z-index: 1;
    margin: 0;
    color: var(--color-neutrals-900);
    font-size: clamp(2.75rem, 6vw, 4.5rem);
    line-height: 1;
    letter-spacing: -0.04em;
  }

  .case-title-line {
    position: absolute;
    z-index: 0;
    inset-block-end: 0.05em;
    inset-inline-start: calc(-50vw + 50%);
    inline-size: calc(50vw + 50%);
    block-size: 0.35rem;
    background-color: var(--color-action);
  }

  .case-intro {
    max-inline-size: 700px;
    margin: 2rem auto 0;
    color: var(--color-text-muted);
    font-size: 0.8rem;
    line-height: 1.7;
  }

  .case-story-article {
    --flow-space: 4rem;

    display: grid;
    grid-template-columns:
      minmax(1rem, 1fr)
      repeat(12, minmax(0, 80px))
      minmax(1rem, 1fr);

    background-color: var(--color-surface-primary);
    color: var(--color-neutrals-900);
  }

  .case-story-header,
  .case-story-content {
    display: grid;
    grid-template-columns: subgrid;
    grid-column: 2 / -2;
    min-inline-size: 0;
  }

  .case-story-header {
    position: relative;
    padding-block-start: 5rem;
  }

  .case-story-header > :global(img) {
    display: block;
    grid-column: 1 / -1;
    inline-size: 100%;
    block-size: auto;
    border-radius: var(--radius-lg);
  }

  .case-details {
    position: relative;
    z-index: 2;
    display: grid;
    grid-column: 2 / -2;
    grid-template-columns: repeat(3, 1fr) auto;
    align-items: center;
    gap: 1.5rem;
    max-inline-size: 900px;
    margin: -3rem auto 0;
    padding: 2rem;
    border-radius: var(--radius-lg);
    background-color: var(--color-neutrals-900);
    color: var(--color-neutrals-50);
  }

  .case-details dl {
    display: contents;
    margin: 0;
  }

  .case-details dl > div {
    display: grid;
    gap: 0.35rem;
  }

  .case-details dt {
    color: var(--color-neutrals-400);
    font-size: 0.65rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .case-details dd {
    margin: 0;
    font-size: 0.85rem;
    font-weight: 600;
  }

  .case-details .category,
  .case-details .date {
    color: var(--color-neutrals-50);
  }

  .case-details .button {
    justify-self: end;
    padding: 0.75rem 1.25rem;
    border-radius: var(--radius-pill);
    background-color: var(--color-action);
    color: var(--color-neutrals-900);
    font-size: 0.7rem;
    font-weight: 700;
    text-decoration: none;
    white-space: nowrap;
  }

  .case-details .button:hover,
  .case-details .button:focus-visible {
    background-color: var(--color-yellow-600);
  }

  .case-story-content {
    padding-block: 5rem 6rem;
  }

  .case-section {
    grid-column: 3 / -3;
    min-inline-size: 0;
  }

  .case-section + .case-section {
    margin-block-start: var(--flow-space);
  }

  .case-story-content h2 {
    margin: 0;
    color: var(--color-neutrals-900);
    font-size: clamp(2rem, 4vw, 3rem);
    line-height: 1.1;
    letter-spacing: -0.04em;
  }

  .case-story-content p {
    max-inline-size: 700px;
    margin-block-start: 1.5rem;
    color: var(--color-text-muted);
    font-size: 0.8rem;
    line-height: 1.8;
  }

  .case-story-content ul {
    display: grid;
    gap: 1rem;
    margin: 2rem 0 0;
    padding: 0;
    list-style: none;
  }

  .case-story-content li {
    position: relative;
    padding-inline-start: 1.5rem;
    color: var(--color-text-muted);
    font-size: 0.8rem;
    line-height: 1.6;
  }

  .case-story-content li::before {
    content: "";
    position: absolute;
    inset-inline-start: 0;
    inset-block-start: 0.55em;
    inline-size: 0.45rem;
    block-size: 0.45rem;
    border-radius: 50%;
    background-color: var(--color-action);
  }

  .case-story-content figure {
    position: relative;
    margin: 2.5rem 0 0;
    overflow: hidden;
    border-radius: var(--radius-lg);
  }

  .case-story-content figure :global(img) {
    display: block;
    inline-size: 100%;
    block-size: auto;
  }

  .case-story-content figcaption {
    position: absolute;
    inset-inline: 0;
    inset-block-end: 0;
    padding: 4rem 1.5rem 1.5rem;
    background: linear-gradient(to top, rgb(3 7 18 / 0.9), rgb(3 7 18 / 0));
    color: var(--color-neutrals-50);
    font-size: 0.75rem;
    line-height: 1.5;
  }

  @media (max-width: 750px) {
    .case-story-article {
      grid-template-columns:
        1rem
        repeat(4, minmax(0, 1fr))
        1rem;
    }

    .case-story-header,
    .case-story-content {
      grid-column: 2 / -2;
    }

    .case-story-header {
      padding-block-start: 3rem;
    }

    .case-details {
      grid-column: 1 / -1;
      grid-template-columns: 1fr 1fr;
      margin-block-start: -2rem;
    }

    .case-details .button {
      justify-self: start;
    }

    .case-section {
      grid-column: 1 / -1;
    }

    .case-story-content {
      padding-block: 4rem 5rem;
    }
  }

  @media (max-width: 500px) {
    .case-story-article {
      grid-template-columns: 1rem minmax(0, 1fr) 1rem;
    }

    .case-story-header,
    .case-story-content {
      grid-column: 2;
    }

    .case-details {
      grid-column: 1 / -1;
      grid-template-columns: 1fr;
      gap: 1.25rem;
      padding: 1.5rem;
    }

    .case-details .button {
      justify-self: start;
    }

    .case-story-content {
      padding-block: 3.5rem 4rem;
    }

    .case-story-content figcaption {
      position: static;
      padding: 1rem;
      background-color: var(--color-neutrals-900);
    }
  }
</style>
