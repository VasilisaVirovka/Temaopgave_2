---
import Layout from "@layouts/Layout.astro";
import TeamDetail from "@components/team/TeamDetail.astro";

export async function getStaticPaths() {
  const response = await fetch("https://ftk-api.pages.dev/team");
  const teamData: { slug: string }[] = await response.json();

  return teamData.map((member) => ({
    params: {
      slug: member.slug,
    },
  }));
}

const { slug } = Astro.params;

const member = await fetch(`https://ftk-api.pages.dev/team/${slug}`).then(
  (res) => res.json(),
);
---

<Layout>
  <TeamDetail member={member} />
</Layout>
