---
//@ts-nocheck
import ServiceCard from "@components/home/ServiceCard.astro";

const serviceData = await fetch("https://ftk-api.pages.dev/services").then(
  (res) => res.json(),
);
---

<section class="services" aria-label="Our services">
  {serviceData.map((service) => <ServiceCard service={service} />)}
</section>

<style>
  @layer components {
    .services {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: var(--space-4);

      max-inline-size: 1200px;
      margin-inline: auto;
      margin-block-start: -5rem;

      padding-inline: 2rem;

      position: relative;
      z-index: 2;
    }

    @media (max-width: 900px) {
      .services {
        grid-template-columns: 1fr;
        margin-block-start: 0;
        padding-block: var(--space-6);
      }
    }
  }
</style>
