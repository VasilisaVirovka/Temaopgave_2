---
type ExperienceStat = {
  label: string;
  value: number;
};

type ExperienceData = {
  eyebrow: string;
  title: string;
  subtitle: string;
  stats: ExperienceStat[];
};

const experienceData: ExperienceData = await fetch(
  "https://ftk-api.pages.dev/experience",
).then((res) => res.json());
---

<section class="experience" aria-labelledby="experience-title">
  <div class="experience-inner">
    <div class="experience-content">
      <p class="eyebrow">{experienceData.eyebrow}</p>

      <h2 id="experience-title">{experienceData.title}</h2>

      <div class="clients">
        <span>3000+ our clients are insured around the World</span>
      </div>
    </div>

    <div class="experience-stats">
      {
        experienceData.stats.map((stat) => (
          <figure
            class="stat-card"
            data-value={stat.value}
            style={`--value: ${stat.value}; --value-percent: ${stat.value}%; --value-number: ${stat.value};`}
          >
            <div class="stat-graphic">
              <svg viewBox="0 0 100 100" aria-hidden="true">
                <circle class="track" />
                <circle class="progress" pathLength="100" />
                <circle class="marker" r="3" />
              </svg>
            </div>

            <figcaption>{stat.label}</figcaption>
          </figure>
        ))
      }
    </div>
  </div>
</section>

<script>
  const supportsOffsetPath = CSS.supports(
    "offset-path: circle(46px at 50px 50px)",
  );

  if (!supportsOffsetPath) {
    document.querySelectorAll<HTMLElement>(".stat-card").forEach((card) => {
      const value = Number(card.dataset.value ?? 0);

      const progress = card.querySelector<SVGCircleElement>(".progress");
      const marker = card.querySelector<SVGCircleElement>(".marker");

      if (!progress || !marker) return;

      card.classList.add("chart-fallback");

      /*
       * Firefox fallback:
       * Draw the progress circle directly with SVG attributes
       * and calculate the marker position with JavaScript.
       */

      progress.style.strokeDasharray = `${value} 100`;
      progress.style.strokeDashoffset = "0";

      const radius = 46;
      const center = 50;

      const angle = (value / 100) * 360 - 90;
      const radians = (angle * Math.PI) / 180;

      const x = center + radius * Math.cos(radians);
      const y = center + radius * Math.sin(radians);

      marker.setAttribute("cx", String(x));
      marker.setAttribute("cy", String(y));
    });
  }
</script>

<style>
  @layer components {
    .experience {
      inline-size: 100%;
      background-color: var(--color-yellow-500);
    }

    .experience-inner {
      display: grid;
      grid-template-columns: 0.9fr 1.1fr;
      align-items: center;
      gap: 4rem;
      max-inline-size: 1200px;
      min-block-size: 300px;
      margin-inline: auto;
      padding: 3rem 2rem;
    }

    .experience-content {
      max-inline-size: 390px;
      margin-inline-start: 5rem;
    }

    .eyebrow {
      margin: 0 0 1rem;
      font-size: 0.7rem;
      font-weight: 700;
      letter-spacing: 0.08em;
      text-transform: uppercase;
    }

    .experience h2 {
      max-inline-size: 390px;
      margin: 0;
      font-size: clamp(2rem, 3.5vw, 2.75rem);
      line-height: 1.05;
    }

    .clients {
      display: flex;
      align-items: center;
      gap: 0.5rem;
      margin-block-start: 1.25rem;
    }

    .clients strong {
      font-size: 2rem;
      line-height: 1;
    }

    .clients span {
      max-inline-size: 220px;
      font-size: 0.65rem;
      line-height: 1.25;
    }

    .experience-stats {
      display: flex;
      justify-content: space-between;
      gap: 2rem;
    }

    .stat-card {
      flex: 1 1 0;
      display: grid;
      grid-template-areas:
        "stat"
        "label";
      justify-items: center;
      margin: 0;

      /* Container query requirement */
      container-type: inline-size;

      --value-number: 0;
    }

    .stat-card::before {
      content: attr(data-value) "%";
      grid-area: stat;
      z-index: 1;
      display: grid;
      place-items: center;
      font-size: 24cqw;
      font-weight: 600;
    }

    .stat-graphic {
      grid-area: stat;
      inline-size: min(135px, 100%);
      aspect-ratio: 1;
    }

    .stat-graphic svg {
      display: block;
      inline-size: 100%;
      block-size: 100%;
      overflow: visible;
      rotate: -90deg;
    }

    /*
     * Original visual solution.
     * This remains active in Chrome and other browsers
     * that support the modern CSS solution.
     */

    .track,
    .progress {
      cx: 50;
      cy: 50;
      r: 46;
      fill: none;
      stroke-width: 4;
    }

    .track {
      stroke: color-mix(in srgb, var(--color-neutrals-900) 15%, transparent);
    }

    .progress {
      stroke: white;
      stroke-linecap: round;
      stroke-dasharray: var(--value-number) 100;
    }

    .marker {
      fill: var(--color-neutrals-900);
      offset-path: circle(46px at 50px 50px);
      offset-distance: calc(var(--value-number) * 1%);
    }

    /*
     * Firefox fallback.
     *
     * Only the marker positioning is replaced.
     * The normal Chrome solution above is untouched.
     */

    .chart-fallback .marker {
      offset-path: none;
      offset-distance: 0;
    }

    .stat-card figcaption {
      grid-area: label;
      margin-block-start: 0.65rem;
      font-size: 0.9rem;
      font-weight: 600;
      text-align: center;
    }

    @media (max-width: 800px) {
      .experience-inner {
        grid-template-columns: 1fr;
        gap: 2rem;
      }

      .experience-content {
        margin-inline-start: 0;
      }

      .experience-stats {
        gap: 1rem;
      }
    }

    @media (max-width: 500px) {
      .experience-inner {
        padding: 2rem 1rem;
      }

      .experience-stats {
        gap: 0.5rem;
      }

      .stat-card::before {
        font-size: 20cqw;
      }

      .stat-graphic {
        inline-size: min(110px, 100%);
      }

      .stat-card figcaption {
        font-size: 0.75rem;
      }
    }
  }
</style>
