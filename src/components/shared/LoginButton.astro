<button
  class="login-button"
  type="button"
  popovertarget="login-popover"
  aria-controls="login-popover"
  aria-expanded="false"
>
  Login
</button>

<div id="login-popover" class="login-popover" popover>
  <div class="login-content">
    <h2>Dashboard Login</h2>

    <form>
      <label for="login-email">Email address</label>
      <input id="login-email" name="email" type="email" autocomplete="email" />

      <label for="login-password">Password</label>
      <input
        id="login-password"
        name="password"
        type="password"
        autocomplete="current-password"
      />

      <button class="dashboard-button" type="submit"> Go to dashboard </button>
    </form>
  </div>
</div>

<script is:inline>
  const loginButton = document.querySelector(".login-button");
  const loginPopover = document.querySelector("#login-popover");

  if (loginButton && loginPopover) {
    const supportsPopover = "popover" in HTMLElement.prototype;

    if (!supportsPopover) {
      loginButton.removeAttribute("popovertarget");

      loginPopover.classList.add("popover-fallback");

      loginButton.addEventListener("click", () => {
        const isOpen = loginPopover.classList.toggle("is-open");

        loginButton.setAttribute("aria-expanded", String(isOpen));
      });

      document.addEventListener("click", (event) => {
        if (
          loginPopover.classList.contains("is-open") &&
          !loginPopover.contains(event.target) &&
          !loginButton.contains(event.target)
        ) {
          loginPopover.classList.remove("is-open");
          loginButton.setAttribute("aria-expanded", "false");
        }
      });

      document.addEventListener("keydown", (event) => {
        if (
          event.key === "Escape" &&
          loginPopover.classList.contains("is-open")
        ) {
          loginPopover.classList.remove("is-open");
          loginButton.setAttribute("aria-expanded", "false");
          loginButton.focus();
        }
      });
    }
  }
</script>

<style>
  @layer components {
    .login-button {
      justify-self: end;
      padding: 0.7rem 1.6rem;
      border: none;
      border-radius: var(--radius-pill);
      background: #ffffff;
      color: var(--color-neutrals-900);
      font: inherit;
      font-size: 0.85rem;
      font-weight: 700;
      line-height: 1;
      cursor: pointer;
    }

    .login-button:hover,
    .login-button:focus-visible {
      background: var(--color-action);
    }

    .login-popover {
      position: fixed;
      inset: auto;

      inline-size: min(520px, calc(100vw - 2rem));

      border: none;
      border-radius: 1.25rem;
      padding: 0;

      background: #ffffff;
      color: var(--color-neutrals-900);
      box-shadow: 0 1rem 3rem rgb(0 0 0 / 15%);

      z-index: 1000;

      /*
       * Fallback for browsers without the Popover API.
       * Hidden until the Login button is pressed.
       */
      &.popover-fallback {
        display: none;
      }

      &.popover-fallback.is-open {
        display: block;
      }
    }

    /*
     * Modern Anchor Positioning.
     * Used when supported by the browser.
     */
    @supports (position-area: bottom) {
      .login-popover {
        inset: auto;
        position-area: bottom;
        margin-block-start: 0.6rem;
      }
    }

    .login-content {
      padding: 2rem 2.5rem 2.25rem;
    }

    .login-content h2 {
      margin: 0 0 1.75rem;
      font-size: clamp(2rem, 4vw, 2.75rem);
      line-height: 1;
      letter-spacing: -0.04em;
    }

    .login-content form {
      display: grid;
      gap: 0;
    }

    .login-content label {
      display: block;
      margin-block-end: 0.5rem;
      font-size: 0.8rem;
      font-weight: 600;
    }

    .login-content input {
      display: block;
      inline-size: 100%;
      block-size: 3rem;
      margin-block-end: 1.25rem;
      padding-inline: 1rem;

      border: 1px solid var(--color-neutrals-200);
      border-radius: var(--radius-pill);

      background: #ffffff;
      color: var(--color-neutrals-900);

      font: inherit;
      box-sizing: border-box;
    }

    .dashboard-button {
      inline-size: 100%;
      block-size: 3rem;
      margin-block-start: 0.25rem;

      border: none;
      border-radius: var(--radius-pill);

      background: var(--color-action);
      color: var(--color-neutrals-900);

      font: inherit;
      font-size: 0.85rem;
      font-weight: 700;
      cursor: pointer;
    }

    .dashboard-button:hover,
    .dashboard-button:focus-visible {
      background: var(--color-yellow-600);
    }

    @media (max-width: 700px) {
      .login-popover {
        inline-size: calc(100vw - 2rem);
      }

      .login-content {
        padding: 2.5rem 2rem;
      }

      .login-content h2 {
        margin-block-end: 2rem;
        font-size: 2.5rem;
      }
    }

    @media (max-width: 450px) {
      .login-content {
        padding: 2rem 1.5rem;
      }

      .login-content h2 {
        font-size: 2rem;
      }

      .login-content input,
      .dashboard-button {
        block-size: 3.5rem;
      }
    }
  }
</style>
