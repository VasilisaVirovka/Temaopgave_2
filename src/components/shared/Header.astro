---
import LoginButton from "./LoginButton.astro";
---

<header class="site-header">
  <div class="header-inner">
    <a class="logo" href="/">AskExperts</a>

    <nav aria-label="Primary navigation">
      <ul>
        <li><a href="/">Home</a></li>
        <li><a href="/case-studies">Case Studies</a></li>
        <li><a href="/team">Team</a></li>
        <li><a href="/about">About</a></li>
      </ul>
    </nav>

    <LoginButton />
  </div>
</header>

<style>
  @layer components {
    .site-header {
      background: var(--color-neutrals-900);
      color: var(--color-on-surface-elevated);
    }

    .header-inner {
      width: min(100% - 2rem, 1200px);
      margin-inline: auto;
      min-block-size: 72px;

      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: var(--space-4);
    }

    .logo {
      color: var(--color-action);
      font-family: var(--font-cabin);
      font-size: 1.25rem;
      font-weight: 700;
      text-decoration: none;
    }

    nav ul {
      display: flex;
      align-items: center;
      gap: var(--space-5);
      list-style: none;
      margin: 0;
      padding: 0;
    }

    nav a {
      color: var(--color-on-surface-elevated);
      text-decoration: none;
      font-size: 0.9rem;
    }

    nav a:hover,
    nav a:focus-visible {
      color: var(--color-action);
    }

    @media (max-width: 700px) {
      .header-inner {
        flex-wrap: wrap;
        padding-block: 1rem;
      }

      nav {
        order: 3;
        flex-basis: 100%;
      }

      nav ul {
        justify-content: center;
        flex-wrap: wrap;
        gap: var(--space-3);
      }
    }
  }
</style>
