---
import LoginButton from "@components/shared/LoginButton.astro";
---

<header class="site-header">
  <nav class="site-nav" aria-label="Main navigation">
    <a class="logo" href="/">
      <span>Ask</span><span>Experts</span>
    </a>

    <ul class="nav-links">
      <li>
        <a href="/">Home</a>
      </li>

      <li>
        <a href="/case-studies/taxes-and-efficiency">Case Studies</a>
      </li>

      <li>
        <a href="/team">Team</a>
      </li>

      <li>
        <a href="/about">About</a>
      </li>
    </ul>

    <LoginButton />
  </nav>
</header>

<style>
  @layer components {
    .site-header {
      container-type: inline-size;

      background-color: var(--color-neutrals-900);
      color: var(--color-on-surface-elevated);
    }

    .site-nav {
      display: grid;
      grid-template-columns: 1fr auto 1fr;
      align-items: center;

      max-inline-size: 1200px;
      margin-inline: auto;
      padding: 1.25rem 2rem;
    }

    .logo {
      justify-self: start;

      color: var(--color-on-surface-elevated);
      font-size: 1.25rem;
      font-weight: 700;
      line-height: 1;
      text-decoration: none;
    }

    .logo span:last-child {
      color: var(--color-action);
    }

    .nav-links {
      display: flex;
      align-items: center;
      gap: 2rem;

      margin: 0;
      padding: 0;

      list-style: none;
    }

    .nav-links a {
      position: relative;

      color: var(--color-on-surface-elevated);
      font-size: 0.875rem;
      font-weight: 600;
      text-decoration: none;
    }

    .nav-links a::after {
      content: "";

      position: absolute;
      inset-inline: 0;
      inset-block-end: -0.4rem;

      block-size: 3px;

      border-radius: var(--radius-pill);
      background-color: var(--color-action);

      transform: scaleX(0);
      transform-origin: center;
      transition: transform 150ms ease;
    }

    .nav-links a:hover::after,
    .nav-links a:focus-visible::after {
      transform: scaleX(1);
    }

    :global(.login-button) {
      justify-self: end;
    }

    @container (max-width: 700px) {
      .site-nav {
        grid-template-columns: 1fr auto;
        gap: var(--space-4);
      }

      .nav-links {
        grid-column: 1 / -1;
        grid-row: 2;

        justify-content: center;
        gap: var(--space-4);
      }
    }
  }
</style>
